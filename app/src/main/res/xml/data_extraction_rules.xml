<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 数据提取规则：云备份与设备迁移均排除敏感存储 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tavern_settings.xml" />
        <exclude domain="sharedpref" path="mistbell_android.xml" />
        <exclude domain="database" path="tavern.db" />
        <exclude domain="database" path="tavern.db-wal" />
        <exclude domain="database" path="tavern.db-shm" />
        <exclude domain="file" path="vector_store.json" />
        <exclude domain="file" path="vector_store.json.bak" />
        <exclude domain="file" path="vector_store_quarantine/" />
        <!-- logs/ 含崩溃与运行日志（可能带用户内容片段），云备份与设备迁移均排除 -->
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tavern_settings.xml" />
        <exclude domain="sharedpref" path="mistbell_android.xml" />
        <exclude domain="database" path="tavern.db" />
        <exclude domain="database" path="tavern.db-wal" />
        <exclude domain="database" path="tavern.db-shm" />
        <exclude domain="file" path="vector_store.json" />
        <exclude domain="file" path="vector_store.json.bak" />
        <exclude domain="file" path="vector_store_quarantine/" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
