<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mistbell era 引擎宿主（Android）。
    只编译 Emuera 内核 + 无窗 EWP 宿主，不包含任何 WinForms / Xamarin.Forms 代码。
    引擎源码在构建期由 CI 拉取到 era-engine/upstream（不入库），本工程以相对路径引用。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <!-- SkiaSharp 3.119.2 的 Android 原生资产只面向 API 34+；显式钉住平台版本 -->
    <TargetPlatformVersion>34.0</TargetPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mistbell.Era.Host</RootNamespace>
    <AssemblyName>MistbellEra</AssemblyName>
    <AndroidApplication>true</AndroidApplication>
    <ApplicationId>com.mistbell.era</ApplicationId>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultAndroidResourceItems>false</EnableDefaultAndroidResourceItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>false</AndroidKeyStore>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 上游内核在多目标下会产生大量可空/重载告警，沿用 headless 工程的豁免集合 -->
    <NoWarn>CS8981;CS8632;CS0618;CS1998;CS0436;CS0037;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0266;CS1503;CS0029;CS1929;CS0176;CS0120;CS0019;CS0030;CS1501;CS0117;CS1061;CS0246;CS0121;CS0119;CS0103;CS7036;CS0200;CS0021;CS1729;CS0122;CS1977;CS0104;CA1416;XA0002</NoWarn>
  </PropertyGroup>

  <!-- 内核 + 共享控制台 + EWP + 无窗宿主（与 Emuera.Headless 同源清单） -->
  <ItemGroup>
    <Compile Include="..\upstream\Emuera\Runtime\**\*.cs" LinkBase="Runtime" />
    <Compile Include="..\upstream\Emuera\UI\Game\**\*.cs" LinkBase="UI\Game" />
    <Compile Include="..\upstream\Emuera\UI\Ewp\**\*.cs" LinkBase="UI\Ewp" />
    <Compile Include="..\upstream\Emuera\UI\Headless\**\*.cs" LinkBase="UI\Headless" />
    <Compile Include="..\upstream\Emuera\UI\IConsoleSurface.cs" LinkBase="UI" />
    <Compile Include="..\upstream\Emuera\UI\FontFactory.cs" LinkBase="UI" />
    <Compile Include="..\upstream\Emuera\UI\Dialog.cs" LinkBase="UI" />
    <Compile Include="..\upstream\Emuera\GlobalStatic.cs" LinkBase="." />
    <Compile Include="..\upstream\Emuera\Program.Shared.cs" LinkBase="." />
    <Compile Include="..\upstream\Emuera.Headless\Stubs\**\*.cs" LinkBase="Stubs" />
    <Compile Include="Android\**\*.cs" />
  </ItemGroup>

  <!-- 与 headless 工程一致的排除项 -->
  <ItemGroup>
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\Sound.WMP.cs" />
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\Sound.NAudio.cs" />
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\NAudio_LoopStream.cs" />
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\SoundTouch_byMarkHeath\**" />
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\MemoryDiagnostic.cs" />
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\EvilMask\Shape.cs" />
    <Compile Remove="..\upstream\Emuera\Runtime\Utils\EvilMask\Utils.Icon.cs" />
    <Compile Remove="..\upstream\Emuera\UI\Game\HotkeyState.cs" />
    <Compile Remove="..\upstream\Emuera\UI\Game\Rikaichan.cs" />
    <Compile Remove="..\upstream\Emuera\UI\Game\RikaichanAutogenerated.cs" />
    <Compile Remove="..\upstream\Emuera\UI\Game\AConsoleDisplayPart.cs" />
    <Compile Remove="..\upstream\Emuera\UI\Game\image\ImgUtils.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\upstream\Emuera\Properties\lang\emuera-eng.xml" Link="Properties\lang\emuera-eng.xml"
                      LogicalName="MinorShift.Emuera.Properties.lang.emuera-eng.xml" />
    <EmbeddedResource Include="..\upstream\Emuera\Properties\lang\emuera-zhs.xml" Link="Properties\lang\emuera-zhs.xml"
                      LogicalName="MinorShift.Emuera.Properties.lang.emuera-zhs.xml" />
    <EmbeddedResource Include="..\upstream\Emuera\Properties\fonts\BIZUDGothic-Regular.ttf" Link="Properties\fonts\BIZUDGothic-Regular.ttf"
                      LogicalName="MinorShift.Emuera.Properties.fonts.BIZUDGothic-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\values\strings.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Enums.NET" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
