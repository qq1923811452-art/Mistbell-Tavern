<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mistbell.Era.Host</RootNamespace>
    <AssemblyName>MistbellEra</AssemblyName>
    <AndroidApplication>true</AndroidApplication>
    <!-- 单包构建时通过 -p:ApplicationId=com.mistbell.tavern.v3 覆盖，保证 libxamarin-app.so 包名一致 -->
    <ApplicationId Condition="'$(ApplicationId)' == ''">com.mistbell.era</ApplicationId>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultAndroidResourceItems>false</EnableDefaultAndroidResourceItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>false</AndroidKeyStore>
    <!-- .NET 10 Android SDK 36.1.69 已知 native marshal 生成 bug 绕过（与 EraCore.Native.Android 一致） -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <!-- Release 开启 Mono Full AOT（不再强行设 false）；Debug 保持 JIT -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(Configuration)' != 'Release'">false</RunAOTCompilation>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Android\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\values\strings.xml" />
  </ItemGroup>

  <!-- 只引用 EraCore 的公共宿主门面（零 SkiaSharp / 零 Avalonia / 零 Kestrel） -->
  <ItemGroup>
    <ProjectReference Include="..\upstream\EraCore.Hosting\EraCore.Hosting.csproj" />
    <!-- legacy-plugin-compat：eraTW 画蛇添足版自带插件，其 AssemblyRef 是
         `Emuera, Version=1.824.0.0, PublicKeyToken=null`。这个 facade 只做类型转发，
         必须随宿主一起打包，否则 PluginManager.LoadPlugins 抛 TypeLoadException → INIT_FAILED。
         EraCore.Cli 在 android RID 下排除了它，但我们的 Android 宿主是产品形态，需要它。 -->
    <ProjectReference Include="..\upstream\EraCore.Compat.Emuera\EraCore.Compat.Emuera.csproj" />
  </ItemGroup>

</Project>
